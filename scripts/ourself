#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# OURSELF — launch the SELF-governed command chamber (Pass 15)
#
# Verifies the bridge directory and Node, starts the ÆTHERNET Agent Bridge if it
# is not already alive, opens the OURSELF command chamber, and prints the local
# URLs. It NEVER prints, reads, or modifies any secret; the bridge reads its own
# token from the gitignored .env. It does not auto-approve anything.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

BRIDGE_DIR="/Users/millysituated/RUORA/projects/agent-bridge"
PORT="${PORT:-3001}"
BASE="http://localhost:${PORT}"

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
gold() { printf '\033[33m%s\033[0m\n' "$*"; }
cyan() { printf '\033[36m%s\033[0m\n' "$*"; }

# 1. Verify the bridge directory exists.
if [ ! -d "$BRIDGE_DIR" ]; then
  red "✗ Bridge directory not found: $BRIDGE_DIR"
  exit 1
fi

# 2. Verify Node is available.
if ! command -v node >/dev/null 2>&1; then
  red "✗ Node is not available on PATH. Install Node, then retry."
  exit 1
fi

# 3. Start the bridge if it is not already running (health probe).
if curl -sf -m 2 "${BASE}/health" >/dev/null 2>&1; then
  cyan "● Bridge already alive on ${BASE}"
else
  gold "⟳ Bridge not running — starting it…"
  # Detach so the chamber survives this shell. Logs go to a local run log.
  ( cd "$BRIDGE_DIR" && nohup npm start >/tmp/ourself-bridge.log 2>&1 & )
  # Wait up to ~10s for /health to come alive.
  for i in $(seq 1 20); do
    if curl -sf -m 2 "${BASE}/health" >/dev/null 2>&1; then
      cyan "● Bridge is alive on ${BASE}"
      break
    fi
    sleep 0.5
    if [ "$i" -eq 20 ]; then
      red "✗ Bridge did not become healthy within ~10s."
      red "  Check /tmp/ourself-bridge.log — most often BRIDGE_TOKEN is unset in .env."
      red "  Generate one with:  (cd $BRIDGE_DIR && npm run setup)"
      exit 1
    fi
  done
fi

# 4. Open the OURSELF command chamber.
if command -v open >/dev/null 2>&1; then
  open "${BASE}/ourself" >/dev/null 2>&1 || true
fi

# 5. Print the exact local URLs.
echo ""
gold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
gold "  OURSELF COMMAND CHAMBER — ONLINE"
gold "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
printf '  Chamber : %s/ourself\n' "$BASE"
printf '  Pending : %s/pending   (display-only mirror)\n' "$BASE"
printf '  Health  : %s/health\n' "$BASE"
printf '  AXIOM   : http://localhost:5174/\n'
echo ""
echo "  Enter your token inside the chamber. By default it is held in tab"
echo "  memory only and discarded on refresh. Optional: choose \"Remember"
echo "  token until this browser tab closes.\" It is never written to disk"
echo "  and the bridge never reveals it."
echo ""
